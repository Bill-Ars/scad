# Regras comuns: timeout curto de ligação (como o heartbeat), corpo grande para os PDF
proxy_connect_timeout 2s;
proxy_read_timeout    60s;
proxy_send_timeout    60s;
client_max_body_size  20m;
proxy_http_version    1.1;
proxy_buffering       off;

# agente-nampula:8080 (nome dentro do PC1)  ->  agente de Nampula no PC2
server { listen 8080; location / { proxy_pass http://${PC2}:8083; } }
